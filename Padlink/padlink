#!/bin/zsh
# One command to build, launch, and drive Padlink.
#
# Everything lives on the worktree branch, not on main, and the Xcode project is
# generated rather than committed. Remembering that every time is friction you do
# not need while testing, so this script resolves its own location and does the
# right thing from anywhere.
#
#   ./padlink team <ID>          set your Apple team id, once
#   ./padlink up                 build and launch the Mac app
#   ./padlink pad                build and launch on the physical iPad
#   ./padlink paste              pair using the code on the clipboard
#   ./padlink pair "<url>"       pair with a code you have as text
#   ./padlink move 200 0         and every other test client command
#   ./padlink test               run all three test suites
#   ./padlink down               quit the app

set -e
cd "$(dirname "$0")"

APP=".build/Build/Products/Debug/PadlinkMac.app"
INSTALLED="/Applications/PadlinkMac.app"
IPAD_SIM="iPad Air 11-inch (M4)"

# A configured Apple team id makes the signature stable across rebuilds, which
# is what stops macOS dropping the Accessibility permission every time. The file
# is gitignored: a team id is account-specific and this repository is public.
SIGNING=()
if [ -f .padlink-team ]; then
  TEAM="$(tr -d '[:space:]' < .padlink-team)"
  if [ -n "$TEAM" ]; then
    SIGNING=(CODE_SIGN_STYLE=Automatic "DEVELOPMENT_TEAM=$TEAM" \
             CODE_SIGN_IDENTITY="Apple Development" -allowProvisioningUpdates)
  fi
fi

case "$1" in
  team)
    if [ -z "$2" ]; then
      echo "Usage: ./padlink team <YOUR_TEAM_ID>"
      echo ""
      echo "Find it in Xcode: Settings > Accounts > pick your Apple ID,"
      echo "then look at the Team column. It is 10 characters, like A1B2C3D4E5."
      [ -f .padlink-team ] && echo "" && echo "Currently set to: $(cat .padlink-team)"
      exit 1
    fi
    echo "$2" > .padlink-team
    echo "Saved. Rebuilds now keep the same signature, so Accessibility"
    echo "permission should stop dropping. Run: ./padlink up"
    ;;

  up)
    echo "Building..."
    [ ${#SIGNING[@]} -eq 0 ] && echo "(ad-hoc signing: expect to re-grant Accessibility after this build)"
    xcodebuild -scheme PadlinkMac -configuration Debug \
      -derivedDataPath .build "${SIGNING[@]}" build -quiet 2>&1 \
      | grep -v "^--- xcodebuild: WARNING" || true
    osascript -e 'quit app "PadlinkMac"' 2>/dev/null || true
    sleep 1

    # Install to /Applications and run from there, rather than running straight
    # out of the build directory. Two reasons, both learned the hard way:
    # the build directory sits inside two dot-folders, so Finder will not show
    # it in the Accessibility file picker; and a clean build deletes it, which
    # silently invalidates the permission and makes the app look broken.
    # A stable path keeps the grant attached to something that persists.
    rm -rf "$INSTALLED"
    cp -R "$APP" /Applications/
    open "$INSTALLED"
    echo ""
    echo "Launched from $INSTALLED"
    echo "Look for the keyboard icon in your menu bar, top right."
    ;;

  down)
    osascript -e 'quit app "PadlinkMac"' 2>/dev/null && echo "Quit." || echo "Was not running."
    ;;

  pad)
    # Build, install, and launch on the physical iPad.
    #
    # The device id is looked up rather than written down. It identifies one
    # person's hardware, and this repository is public. `.padlink-device`
    # overrides the lookup when more than one iPad is attached; it is
    # gitignored for the same reason.
    if [ -f .padlink-device ]; then
      DEVICE="$(tr -d '[:space:]' < .padlink-device)"
    else
      # Matched by shape, not by column position: the Model column contains
      # spaces ("iPad Air (5th generation)"), so counting fields picks the
      # wrong one.
      DEVICE="$(xcrun devicectl list devices 2>/dev/null \
        | grep -i 'ipad' | grep 'available' \
        | grep -oE '[0-9A-Fa-f]{8}(-[0-9A-Fa-f]{4}){3}-[0-9A-Fa-f]{12}' \
        | head -1)"
    fi
    if [ -z "$DEVICE" ]; then
      echo "No available iPad found."
      echo "Plug it in and unlock it, then check: xcrun devicectl list devices"
      exit 1
    fi
    if [ ${#SIGNING[@]} -eq 0 ]; then
      echo "No team id set. A physical iPad will not run an ad-hoc signed build."
      echo "Run: ./padlink team <YOUR_TEAM_ID>"
      exit 1
    fi

    echo "Building for the iPad..."
    # A separate derived data path from the Mac build. Sharing one makes every
    # switch between Mac and device a full rebuild.
    xcodebuild -scheme PadlinkPad -destination "id=$DEVICE" \
      -derivedDataPath .build-device "${SIGNING[@]}" build -quiet 2>&1 \
      | grep -v "^--- xcodebuild: WARNING" || true

    APP_PAD=".build-device/Build/Products/Debug-iphoneos/PadlinkPad.app"
    echo "Installing..."
    xcrun devicectl device install app --device "$DEVICE" "$APP_PAD" > /dev/null
    xcrun devicectl device process launch --device "$DEVICE" \
      com.hengkysandy.padlink.pad > /dev/null
    echo ""
    echo "Launched on the iPad."
    echo "If iOS says the developer is not trusted, open Settings, then"
    echo "General, then VPN & Device Management, and trust the certificate."
    ;;

  paste)
    # Clicking "Pair a device" puts the URL on the clipboard, so pairing needs
    # no copying by hand and no visible window.
    URL_FROM_CLIPBOARD="$(pbpaste)"
    case "$URL_FROM_CLIPBOARD" in
      padlink://*)
        swift run --quiet padlink-testclient pair "$URL_FROM_CLIPBOARD"
        ;;
      *)
        echo "The clipboard does not hold a pairing code."
        echo "Click the menu bar icon, then 'Pair a device', then run this again."
        exit 1
        ;;
    esac
    ;;

  test)
    echo "=== Core ==="
    swift test 2>&1 | tail -1
    echo "=== Mac app ==="
    xcodebuild test -scheme PadlinkMac -destination 'platform=macOS,arch=arm64' 2>&1 \
      | grep -E "Executed [0-9]+ tests?.*seconds|TEST SUCCEEDED|TEST FAILED" | tail -2
    echo "=== iPad app ==="
    # The simulator can report "Application failed preflight checks" if it is
    # still booting when the test runner tries to install, so boot it first.
    xcrun simctl bootstatus "$IPAD_SIM" -b > /dev/null 2>&1 || true
    xcodebuild test -scheme PadlinkPad -destination "platform=iOS Simulator,name=$IPAD_SIM" 2>&1 \
      | grep -E "Executed [0-9]+ tests?.*seconds|TEST SUCCEEDED|TEST FAILED" | tail -2
    ;;

  "")
    echo "Usage: ./padlink up | down | test | pair \"<url>\" | move 200 0 | click left | ..."
    ;;

  *)
    # Anything else goes straight to the test client.
    swift run --quiet padlink-testclient "$@"
    ;;
esac
